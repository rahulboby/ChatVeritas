{
  "llm": {
    "url" : "https://api.groq.com/openai/v1",
    "provider": "groq",
    "model": "openai/gpt-oss-120b",
    "temperature": 0.3,
    "max_retries": 1
  },

  "embedding": {
    "model": "sentence-transformers/all-MiniLM-L6-v2",
    "device": "cpu"
  },

  "reranker": {
    "model": "cross-encoder/ms-marco-MiniLM-L-6-v2",
    "device": "cpu"
  },

  "retrieval": {
    "top_k": 9,
    "chunk_size": 2000,
    "chunk_overlap": 100,
    "faiss_candidates": 100
  },

  "generation": {
    "max_new_tokens": 4000,
    "temperature": 0.4
  },

  "paths": {
    "raw_data": "data/raw",
    "vectorstore": "data/vectorstore"
  },

  "cache": {
    "enabled": true,
    "directory": "data/cache"
  }
}